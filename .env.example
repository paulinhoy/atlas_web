# =============================================================================
# Atlas Web — Configuração do Chatbot e APIs
# Copie este arquivo como .env e preencha com suas chaves reais.
# =============================================================================

# === API Keys (obrigatório pelo menos uma) ===
OPENAI_API_KEY=sk-your-openai-key-here
GOOGLE_API_KEY=your-google-api-key-here

# === LLM — Provider e Modelo ===
# Provider ativo: "openai" ou "gemini"
LLM_PROVIDER=openai
# Modelos utilizados por cada provider
LLM_MODEL_GEMINI=gemini-2.0-flash
LLM_MODEL_OPENAI=gpt-5.6-luna
# Temperatura (0.0 = determinístico, 1.0 = criativo)
LLM_TEMPERATURE=0.3
# Máximo de tokens na resposta da LLM
LLM_MAX_TOKENS=800

# === Rate Limiting (por sessão do navegador) ===
# Mensagens permitidas por minuto
RATE_LIMIT_PER_MINUTE=6
# Mensagens permitidas por dia
RATE_LIMIT_PER_DAY=100
# Máximo de caracteres aceitos no input do usuário
MAX_INPUT_CHARS=1000
# Quantidade de mensagens recentes enviadas como contexto à LLM
MAX_HISTORY_MESSAGES=20

# === Budget Diário (kill-switch de custo) ===
# Gasto máximo diário em Reais — ao atingir, o chatbot desliga até o dia seguinte
BUDGET_DAILY_BRL=5.00
